# Keystore Configuration Template
# Copy this file to keystore.properties and fill in your values
# DO NOT commit keystore.properties to version control!

# Path to your keystore file (relative to android/ directory)
# Example: ../my-release-key.jks or /absolute/path/to/keystore.jks
storeFile=YOUR_KEYSTORE_PATH

# Password for the keystore
storePassword=YOUR_STORE_PASSWORD

# Alias for your key
keyAlias=YOUR_KEY_ALIAS

# Password for the key
keyPassword=YOUR_KEY_PASSWORD

# Instructions:
# 1. Generate keystore (if not exists):
#    keytool -genkey -v -keystore quantum-collision-lab.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 \
#      -alias quantum-collision-lab
#
# 2. Copy this file:
#    cp keystore.properties.template keystore.properties
#
# 3. Edit keystore.properties with your values
#
# 4. Uncomment signing config in app/build.gradle
#
# 5. Build release:
#    ./gradlew bundleRelease
#
# SECURITY:
# - Never commit keystore.properties to git (already in .gitignore)
# - Never commit keystore file to git
# - Keep multiple backups of keystore file
# - Store passwords in password manager
# - If lost, you cannot update your app!
